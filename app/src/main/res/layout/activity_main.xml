<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vimo"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Fast, predictable video editing core"
            android:textSize="16sp" />

        <Button
            android:id="@+id/newProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New project" />

        <Button
            android:id="@+id/resumeProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resume last project" />

        <Button
            android:id="@+id/sampleProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open sample project" />

        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ready" />
    </LinearLayout>
</ScrollView>
